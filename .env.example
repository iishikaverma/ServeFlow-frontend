# Base URL of the ServeFlow C++ API (Crow). Defaults to the dev server.
VITE_API_BASE_URL=http://localhost:18080

# Force demo/mock data regardless of the API being up (useful for a deployed
# portfolio build). Leave unset/false to use the live API with automatic
# fallback to demo data when the server is unreachable.
# VITE_USE_MOCK=true
